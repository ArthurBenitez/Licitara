# Copy these values into the environment of the process that runs server.py.
# Never publish demo accounts or run DEMO_MODE=1 on a public deployment.
DEMO_MODE=1
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/licitara.db
COOKIE_SECURE=0

# Set DEMO_MODE=0 and provide these values to bootstrap the first admin.
# ADMIN_NAME=Platform administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Use-a-long-unique-password

# Optional SMTP for registration and approval notices.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=secret-from-your-secret-manager
# SMTP_FROM=Licitara <notifications@example.com>

# Optional OpenAI-compatible chat completion support.
# Without this key, the app uses a deterministic search assistant over PNCP records.
# OPENAI_API_KEY=secret-from-your-secret-manager
# OPENAI_MODEL=gpt-4o-mini

# Optional server logging.
# APP_DEBUG=1
