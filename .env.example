# Copy these values into the environment of the process that runs server.py.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/licitara.db

# Optional OpenAI-compatible chat completion support.
# Without this key, the app uses a deterministic search assistant over PNCP records.
# OPENAI_API_KEY=secret-from-your-secret-manager
# OPENAI_MODEL=gpt-4o-mini

# Optional server logging.
# APP_DEBUG=1
